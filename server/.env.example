PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Live Source MongoDB (READ-ONLY Source)
SOURCE_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Reporting Admin MongoDB (Application Auth, Admin Users, Roles, Date Windows, Audit Logs)
REPORTING_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gh_reporting_admin?retryWrites=true&w=majority
